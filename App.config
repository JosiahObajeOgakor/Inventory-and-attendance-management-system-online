<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      EDIT THIS to point at your SQL Server instance, then use the "Test database
      connection" button on the login screen to confirm it before deploying.

      Windows Authentication (recommended for a single-office LAN):
        Server=YOUR_SERVER_NAME;Database=StockDeskDB;Integrated Security=True;TrustServerCertificate=True;

      SQL Server Authentication (username/password login):
        Server=YOUR_SERVER_NAME;Database=StockDeskDB;User Id=YOUR_LOGIN;Password=YOUR_PASSWORD;TrustServerCertificate=True;

      Local default instance on this same machine:            Server=localhost;...
      Named instance (e.g. SQL Server Express):                Server=localhost\SQLEXPRESS;...
      Another PC on the office network:                        Server=192.168.1.20;...  (or its machine name)

      TrustServerCertificate=True avoids an SSL-certificate error against a SQL
      Server that doesn't have a trusted certificate installed — normal for an
      in-office server. Remove it only if you've set up proper TLS certificates.
    -->
    <add name="StockDeskDB" providerName="System.Data.SqlClient"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=StockDeskDB;Integrated Security=True;TrustServerCertificate=True;" />
  </connectionStrings>
  <appSettings>
    <add key="CompanyName" value="ChewyPetsFeed" />
    <add key="CurrencySymbol" value="₦" />
    <add key="VatRate" value="7.5" />

    <!-- ===== EDIT THESE before printing real receipts / waybills ===== -->
    <add key="CompanyAddress" value="[Company address — street, city, state]" />
    <add key="CompanyPhone"   value="[Company phone]" />
    <add key="CompanyEmail"   value="[Company email]" />
    <add key="CompanyTaxID"   value="[Company Tax ID / TIN]" />
    <!-- Bank accounts printed on every receipt (add Bank3* for a third). -->
    <add key="BankName"           value="FirstMonie Bank" />
    <add key="BankAccountName"    value="ChewyPets Farm &amp; Feeds" />
    <add key="BankAccountNumber"  value="8676752988" />
    <add key="Bank2Name"          value="First Bank PLC" />
    <add key="Bank2AccountName"   value="ChewyPets Farm &amp; Feeds" />
    <add key="Bank2AccountNumber" value="2047950632" />
    <!-- ===== Candid Purrfect Pets — the second business on the sign-in screen =====
         Same keys as above with a "Candid" prefix. Its data lives in its own
         database (CandidPurrfectDB) on the same server. -->
    <add key="CandidCompanyName"     value="Candid Purrfect Pets Company Ltd" />
    <add key="CandidCompanyAddress"  value="[Candid Purrfect address — street, city, state]" />
    <add key="CandidCompanyPhone"    value="[Candid Purrfect phone]" />
    <add key="CandidCompanyEmail"    value="[Candid Purrfect email]" />
    <add key="CandidCompanyTaxID"    value="[Candid Purrfect Tax ID / TIN]" />
    <add key="CandidBankName"           value="Sterling Bank PLC" />
    <add key="CandidBankAccountName"    value="Candid Purrfect Pets Company Ltd" />
    <add key="CandidBankAccountNumber"  value="0097166161" />
    <add key="CandidBank2Name"          value="First Bank PLC" />
    <add key="CandidBank2AccountName"   value="Candid Purrfect Pets Company Ltd" />
    <add key="CandidBank2AccountNumber" value="2045958847" />

    <!-- Default rebate rate (%). Also stored in AppSettings 'rebate.ratePct'
         and overridable per customer on the Customers screen. -->
    <add key="RebateRatePct" value="1.0" />

    <!-- Local AI (Ollama). No internet needed once the model is pulled.
         Change the model to one you've run "ollama pull <model>" for. -->
    <add key="OllamaUrl"   value="http://localhost:11434" />
    <add key="OllamaModel" value="phi3:mini" />

    <!-- Activation-request delivery (all optional). If none are set, the
         "Request key" button opens the user's email app with the message ready.
         ActivationRequestUrl: a POST endpoint that relays the email.
         Smtp*: send directly (use an app password, never a real account password). -->
    <!-- Licensing service. Activation, payment and key delivery all go through
         this. Change only for a self-hosted / staging instance. -->
    <add key="LicenseApiUrl" value="https://stockdesk-licensing.onrender.com" />
    <!-- Support / development only: 'true' unlocks everything without a licence. -->
    <add key="SkipActivation" value="false" />

    <!-- Auto-logout for Admin sessions after this many idle minutes (Clerks are
         never auto-logged-out). Set 0 to disable. -->
    <add key="AdminIdleLogoutMinutes" value="5" />

    <!-- Database storage. The bundled LocalDB engine caps each database at
         10 GB (10240 MB); leave DbSizeLimitMB at 0 to use that automatically.
         Admins are prompted to back up + archive once usage passes DbSizeWarnPercent. -->
    <add key="DbSizeLimitMB" value="0" />
    <add key="DbSizeWarnPercent" value="80" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
