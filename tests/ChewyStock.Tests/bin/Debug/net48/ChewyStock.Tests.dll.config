<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Tests run against their own LocalDB instance and their own data folder,
         so they can never touch a real ChewyStock database on this PC. -->
    <add name="StockDeskDB" providerName="System.Data.SqlClient" connectionString="Server=(localdb)\ChewyStockTest;Database=StockDeskDB;Integrated Security=True;TrustServerCertificate=True;" />
  </connectionStrings>
  <appSettings>
    <add key="DataDir" value="%TEMP%\ChewyStockTestData" />
    <add key="CompanyName" value="ChewyPetsFeed" />
    <add key="CurrencySymbol" value="₦" />
    <add key="VatRate" value="7.5" />
    <add key="CompanyAddress" value="12 Feed Mill Road, Lagos" />
    <!-- Left as an unfilled placeholder on purpose: it must never print. -->
    <add key="CompanyPhone" value="[Company phone]" />
    <add key="BankName" value="FirstMonie Bank" />
    <add key="BankAccountName" value="ChewyPets Farm &amp; Feeds" />
    <add key="BankAccountNumber" value="8676752988" />
    <add key="Bank2Name" value="First Bank PLC" />
    <add key="Bank2AccountName" value="ChewyPets Farm &amp; Feeds" />
    <add key="Bank2AccountNumber" value="2047950632" />
    <add key="RebateRatePct" value="1.0" />
    <add key="SkipActivation" value="false" />
    <add key="DbSizeLimitMB" value="0" />
    <add key="DbSizeWarnPercent" value="80" />
    <add key="AdminIdleLogoutMinutes" value="5" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>