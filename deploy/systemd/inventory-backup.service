[Unit]
Description=Inventory MySQL backup (encrypted with age, uploaded to Cloudflare R2)
After=mysql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=inventory-backup
Group=inventory-backup
ExecStart=/usr/local/bin/inventory-backup
# R2 credentials come from /etc/inventory/backup.env (an R2 token limited to the backup bucket).
Nice=10
