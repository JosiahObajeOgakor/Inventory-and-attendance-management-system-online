# Copy to .dev/secrets.env (git-ignored) for local development. One KEY=value per line; dev.ps1 loads it when the API starts.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
ConnectionStrings__Default=Server=127.0.0.1;Port=3306;User=inventory_app;Password=<strong-random>;
# Only set while creating the first admin, then remove it:
Setup__Token=<random-one-time-token>

# ---- Assistant (OpenAI). Get a key at platform.openai.com; rotate it if it is ever shared. ----
OpenAI__ApiKey=<sk-...>
# Cheapest tool-capable model. Change here if your account can't use it.
OpenAI__Model=gpt-4.1-nano
OpenAI__DailyMessageLimit=10

# ---- Email (Zoho Mail SMTP). Use the mailbox that sends for the business, e.g. the Candid Purrfect account. ----
# smtppro.zoho.com for Zoho Workplace / custom domains, smtp.zoho.com for free accounts (.eu / .in for those data centres).
Smtp__Host=smtppro.zoho.com
Smtp__Port=465
Smtp__User=<mailbox@yourdomain.com>
# If the Zoho account has two-factor on, create an App Password (Zoho Accounts > Security > App Passwords) and use that.
Smtp__Password=<zoho-password-or-app-password>

# ---- The public site. Receipts' and quotations' PAY ONLINE button opens <PublicUrl>/pay/…, where the customer picks Paystack or AlatPay.
# Leave empty locally (documents then link straight to a Paystack checkout).
Site__PublicUrl=https://chewypetsfeeds.com

# ---- Online payments (Paystack). Every quotation and every invoice with a balance gets a clickable pay link for the exact amount. ----
# In the Paystack dashboard (Settings > API Keys & Webhooks) set the webhook URL to https://YOUR-DOMAIN/api/paystack/webhook
Paystack__SecretKey=<sk_live_... or sk_test_...>
Paystack__PublicKey=<pk_live_... or pk_test_...>
# Where the customer lands after paying (optional): https://YOUR-DOMAIN/paid
Paystack__CallbackUrl=
# Who is told when an invoice is paid. Email works with the Smtp settings above; SMS needs a Termii account (leave the key empty to skip SMS).
Notify__AdminEmail=<admin@yourdomain.com>
Notify__AdminPhone=<09150464707>
Notify__SmsApiKey=
Notify__SmsSenderId=

# ---- Sales assistant (customer-facing, WhatsApp + web chat). Uses the OpenAI key/model above. ----
SalesAssistant__MaxToolRounds=6
SalesAssistant__DailyMessagesPerConversation=60

# ---- WhatsApp Business Cloud API (Meta). One number live for now (ChewyPets); add index 1 for Candid Purrfect's own number later.
# Webhook URL to set in the Meta App's WhatsApp > Configuration screen: https://YOUR-DOMAIN/api/whatsapp/webhook ----
# Pick any random string yourself; enter the SAME value again in Meta's webhook Verify Token field.
WhatsApp__VerifyToken=<choose-a-random-string>
# From the Meta App's WhatsApp > API Setup page.
WhatsApp__Numbers__0__PhoneNumberId=<phone-number-id>
WhatsApp__Numbers__0__CompanyKey=chewypets
# A permanent System User access token (Business Settings > System Users), not the 24-hour test token.
WhatsApp__Numbers__0__AccessToken=<permanent-access-token>
# App Settings > Basic > App Secret.
WhatsApp__Numbers__0__AppSecret=<app-secret>
WhatsApp__Numbers__0__BusinessAccountId=<whatsapp-business-account-id>

# ---- AlatPay (second payment option; customers pick Paystack or AlatPay in the chat). AlatPay dashboard > Settings > API Keys. ----
# Webhook URL to register in the AlatPay dashboard, one per company: https://YOUR-DOMAIN/api/alatpay/webhook/chewypets
AlatPay__SecretKey=<alatpay-secret-key>
AlatPay__WebhookSecret=<alatpay-webhook-secret>
AlatPay__BusinessId=<alatpay-business-id>
# Where the customer's browser lands after paying (optional, display only): https://YOUR-DOMAIN/
AlatPay__RedirectUrl=
# Sandbox testing: https://apibox.alatpay.ng is used for both; the key decides test vs live.
# AlatPay__BaseUrl=https://apibox.alatpay.ng

# ---- Fulfilment: who is told on WhatsApp when an online order is paid. ----
# Delivery zones and fees are NOT set here: admins manage them in the inventory app (Company & documents > Delivery zones).
# The owner's PERSONAL WhatsApp (not the business number customers message) and the dispatch rider.
Fulfilment__AdminWhatsApp=<08012345678>
Fulfilment__RiderName=<rider name>
Fulfilment__RiderPhone=<rider WhatsApp number>
# Meta-approved message templates (Business Manager > WhatsApp Manager > Message templates). Defaults shown.
# order_paid_admin body:  New paid order {{1}}: ₦{{2}} via {{3}}. Customer: {{4}} ({{5}}). Deliver to: {{6}} ({{7}}). Items: {{8}}.
# dispatch_new_order body: New delivery {{1}} (order {{2}}). Items: {{3}}. Deliver to: {{4}}. Customer: {{5}}, phone {{6}}.
Fulfilment__AdminTemplate=order_paid_admin
Fulfilment__RiderTemplate=dispatch_new_order
Fulfilment__TemplateLanguage=en

# ---- WhatsApp sales chat on Twilio + AlatPay (see docs/WHATSAPP_SALES_SETUP.md). The older Meta WhatsApp block above still works; this is the deterministic, in-chat-payment flow. ----
Twilio__AccountSid=<AC...>
Twilio__AuthToken=<auth-token>
# Public https address Twilio calls (ngrok while testing), no trailing slash. Webhook: https://YOUR-DOMAIN/api/twilio/whatsapp
Twilio__PublicBaseUrl=<https://your-domain>
Twilio__Numbers__0__From=<+14155238886 (sandbox) or your approved sender>
Twilio__Numbers__0__CompanyKey=chewypets
# AlatPay dashboard. Webhook: https://YOUR-DOMAIN/api/alatpay/webhook
AlatPay__SubscriptionKey=<Ocp-Apim-Subscription-Key>
AlatPay__BusinessId=<business-guid>
AlatPay__WebhookSecret=<webhook-secret>
# Hard ceiling on AI calls for one sale; a normal sale uses none.
SalesAssistant__MaxAiCallsPerSale=10
SalesAssistant__ReservationMinutes=60
# Optional JSON of native-speaker wording (Igala): see the doc.
SalesAssistant__PhrasesFile=

# ---- Campaigns (reminders, offers, restock alerts; switched on and scheduled in the app under Campaigns) ----
# Approved WhatsApp template SIDs (Twilio Console > Content Template Builder). Needed to message customers outside the 24-hour window.
Twilio__Templates__Reorder=
Twilio__Templates__UnpaidOrder=
Twilio__Templates__Promo=
Twilio__Templates__AdminRestock=
# Email via Twilio SendGrid (falls back to the Smtp mailbox above when empty).
SendGrid__ApiKey=
SendGrid__FromEmail=
# Signs the unsubscribe link in every email; falls back to Twilio__AuthToken. PublicBaseUrl falls back to Twilio__PublicBaseUrl.
Campaigns__SecretKey=
Campaigns__PublicBaseUrl=
Campaigns__AdminName=
Campaigns__MaxAiCallsPerRun=15
