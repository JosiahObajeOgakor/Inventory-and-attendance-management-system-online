{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "3c5f7dd8-f0b9-40ba-a150-beaa92ad4178"
  },
  "newProjectRoot": "projects",
  "projects": {
    "landing-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/fredoka/400.css",
              "node_modules/@fontsource/fredoka/500.css",
              "node_modules/@fontsource/fredoka/600.css",
              "node_modules/@fontsource/fredoka/700.css",
              "node_modules/@fontsource/plus-jakarta-sans/400.css",
              "node_modules/@fontsource/plus-jakarta-sans/500.css",
              "node_modules/@fontsource/plus-jakarta-sans/600.css",
              "node_modules/@fontsource/plus-jakarta-sans/700.css",
              "node_modules/@fontsource/dm-mono/400.css",
              "node_modules/@fontsource/dm-mono/500.css",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "landing-ui:build:production"
            },
            "development": {
              "buildTarget": "landing-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
