<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48 = .NET Framework 4.8, already built into Windows 10 — no separate
         runtime installer for the client, keeping this at zero extra cost. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>StockDesk</RootNamespace>
    <!-- Product name shown to users: ChewyStock.exe, with the Chewy Pet icon. -->
    <AssemblyName>ChewyStock</AssemblyName>
    <Product>ChewyStock</Product>
    <AssemblyTitle>ChewyStock</AssemblyTitle>
    <Company>ChewyPetsFeed</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>StockDesk.Program</StartupObject>
    <MyType>Windows</MyType>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Data.SqlClient and System.Windows.Forms are inbox on net48;
         only System.Configuration needs an explicit reference. -->
    <Reference Include="System.Configuration" />
    <!-- System.Net.Http is inbox on net48 but not referenced by default. -->
    <Reference Include="System.Net.Http" />
    <!-- DataTable.AsEnumerable lives here; inbox on net48, not referenced by default. -->
    <Reference Include="System.Data.DataSetExtensions" />
    <!-- WMI (machine fingerprint for the installation key). -->
    <Reference Include="System.Management" />
    <!-- WPF MediaElement hosted in WinForms — plays the clerk welcome clip. -->
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Text.Json is not part of the .NET Framework — pull it from NuGet. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Excel (.xlsx) export of monthly/yearly reports. net48-compatible. -->
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <!-- QR symbol encoding (Reed-Solomon + masking). Managed-only, no native bits,
         so it travels with the release folder the installer already copies. -->
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project (tests\) builds separately and references this one. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Branding assets (logo.png) copied next to the exe; loaded by Theme.Logo. -->
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- First-run database setup (DbBootstrap.vb) reads this from next to the exe. -->
    <None Update="Schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SDK-style projects auto-include every .vb file in this folder — no need
       to list frmLogin.vb, ucInventory.vb, etc. individually. App.config is
       picked up automatically and copied out as StockDesk.exe.config on build. -->

</Project>
